.global _start
_start:
    cld
    movq $584100, view_cx(%rip)
    movq $43646100, view_cy(%rip)
    movq $2, %rdi
    call init_navigation
    movq $SYS_OPEN, %rax
    leaq dev_tty(%rip), %rdi
    movq $O_RDWR, %rsi
    syscall
    testq %rax, %rax
    jns L1__start
    xorq %rax, %rax
