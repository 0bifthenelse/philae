    pushq %r12
    pushq %r13
    pushq %r14
    pushq %r15
    movq cols(%rip), %rbx
    subq $6, %rbx
    xorq %r12, %r12
L1_draw_zoom_ladder:
    cmpq $ZOOM_LEVELS, %r12
    jae L9_draw_zoom_ladder
    movq %rbx, %rdi
    leaq 3(,%r12,2), %rsi
    movb $'-', %dl
    movb $PRIO_UI, %cl
    movb $STYLE_DIM_TEAL, %r8b
    cmpq zoom_index(%rip), %r12
    jne L2_draw_zoom_ladder
    movb $'#', %dl
    movb $STYLE_BRIGHT_AMBER, %r8b
L2_draw_zoom_ladder:
    call put_styled_cell
    cmpq zoom_index(%rip), %r12
    jne L8_draw_zoom_ladder
    leaq zoom_labels(%rip), %rax
    movq (%rax,%r12,8), %r13
    xorq %r14, %r14
L3_draw_zoom_ladder:
    cmpb $0, (%r13,%r14)
    je L4_draw_zoom_ladder
    incq %r14
    jmp L3_draw_zoom_ladder
L4_draw_zoom_ladder:
    movq %rbx, %rdi
    subq %r14, %rdi
    decq %rdi
    leaq 3(,%r12,2), %rsi
    movb $'Z', %dl
    movb $PRIO_UI, %cl
    movb $STYLE_BRIGHT_AMBER, %r8b
    call put_styled_cell
    xorq %r15, %r15
L5_draw_zoom_ladder:
