transform:
    movq %rdi, %rax
    subq view_cx(%rip), %rax
    imulq kx(%rip), %rax
    sarq $20, %rax
    movq %rax, %rdx
    movq view_cy(%rip), %rax
    subq %rsi, %rax
    imulq ky(%rip), %rax
    sarq $20, %rax
    xchgq %rax, %rdx
    ret

