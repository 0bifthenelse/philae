    jae L8_draw_zoom_ladder
    movq %rbx, %rdi
    subq %r14, %rdi
    addq %r15, %rdi
    leaq 3(,%r12,2), %rsi
    movb (%r13,%r15), %dl
    movb $PRIO_UI, %cl
    movb $STYLE_BRIGHT_AMBER, %r8b
    call put_styled_cell
    incq %r15
    jmp L5_draw_zoom_ladder
L8_draw_zoom_ladder:
    incq %r12
    jmp L1_draw_zoom_ladder
L9_draw_zoom_ladder:
    popq %r15
    popq %r14
    popq %r13
    popq %r12
    popq %rbx
    ret

