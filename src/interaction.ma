 01111001 00100000 01101101 01101111 01110110 01100101 01110011 00100000 01110100 01101000 01100101 00100000 01110110 01101001 01100101 01110111 01110000 01101111 01110010 01110100 00100000 01100011 01100101 01101110 01110100 01100101 01110010 00111011 00100000 01110100 01101000 01100101 00100000 01101110 01100101 01111000 01110100 00100000 01110010 01100101 01101110 01100100 01100101 01110010 00100000 01110010 01100101 01100011 01101111 01101101 01110000 01110101 01110100 01100101 01110011 00100000 01100001 01101100 01101100 00100000 01100011 01100101 01101100 01101100 01110011 00100000 01100110 01110010 01101111 01101101 00100000 01110111 01101111 01110010 01101100 01100100 00100000 01100011 01101111 01101111 01110010 01100100 01101001 01101110 01100001 01110100 01100101 01110011 00101100 00100000 01101110 01100101 01110110 01100101 01110010 00100000 01100010 01111001 00100000 01110011 01101000 01101001 01100110 01110100 01101001 01101110 01100111 00100000 01100001 00100000 01110100 01100101 01111000 01110100 00100000 01100010 01110101 01100110 01100110 01100101 01110010 00101110 00100000 01000000 01101001 01101110 00100000 01110100 01100101 01110010 01101101 00100000 01110010 01100001 01110111 00101100 00100000 01101101 01100001 01110000 00100000 01101100 01101111 01100001 01100100 01100101 01100100 00100000 01000000 01101111 01110101 01110100 00100000 01110101 01110000 01100100 01100001 01110100 01100101 01100100 00100000 01110110 01101001 01100101 01110111 00100000 01100011 01100101 01101110 01110100 01100101 01110010 00100000 01101111 01101110 00100000 01110000 01100001 01101110 00111011 00100000 01100011 01101100 01100101 01100001 01101110 00100000 01100101 01111000 01101001 01110100 00100000 01101111 01101110 00100000 01110001*/
main_loop:
    call render_frame
    movq $SYS_POLL, %rax
    leaq pollfds(%rip), %rdi
    movq $1, %rsi
    movq $POLL_MS, %rdx
    syscall
    testq %rax, %rax
    js die_poll
    jz main_loop
    testw $POLLHUP|POLLERR, pollfds+6(%rip)
    jnz exit_clean
    movq $SYS_READ, %rax
    movq tty_fd(%rip), %rdi
    leaq keybuf(%rip), %rsi
    movq $16, %rdx
    syscall
    testq %rax, %rax
    jle exit_clean
    leaq keybuf(%rip), %rsi
    movq %rax, %rcx
key_loop:
    movzbq (%rsi), %rax
    cmpb $'h', %al
    je key_h
    cmpb $'H', %al
    je key_h
    cmpb $'l', %al
    je key_l
    cmpb $'L', %al
    je key_l
    cmpb $'j', %al
    je key_j
    cmpb $'J', %al
    je key_j
    cmpb $'k', %al
    je key_k
    cmpb $'K', %al
    je key_k
    cmpb $'q', %al
    je exit_clean
    cmpb $'Q', %al
    je exit_clean
key_next:
    incq %rsi
    decq %rcx
    jnz key_loop
    jmp main_loop
key_h:
    movq view_cx(%rip), %rax
    subq $PAN_X, %rax
    movq %rax, view_cx(%rip)
    jmp key_next
key_l:
    movq view_cx(%rip), %rax
    addq $PAN_X, %rax
    movq %rax, view_cx(%rip)
    jmp key_next
key_j:
    movq view_cy(%rip), %rax
    subq $PAN_Y, %rax
    movq %rax, view_cy(%rip)
    jmp key_next
key_k:
    movq view_cy(%rip), %rax
    addq $PAN_Y, %rax
    movq %rax, view_cy(%rip)
    jmp key_next
die_poll:
    leaq msg_poll(%rip), %rdi
    call die
