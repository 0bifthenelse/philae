main_loop:
    call render_frame
    movq $SYS_POLL, %rax
    leaq pollfds(%rip), %rdi
    movq $1, %rsi
    movq $POLL_MS, %rdx
    syscall
    testq %rax, %rax
    js die_poll
    jnz L1_main_loop
    cmpb $0, search_escape_state(%rip)
    je main_loop
    movb $0, search_escape_state(%rip)
    movb $0, search_active(%rip)
    movq $0, search_len(%rip)
    movb $0, search_query(%rip)
    jmp main_loop
L1_main_loop:
    testw $POLLHUP|POLLERR, pollfds+6(%rip)
    jnz exit_clean
    movq $SYS_READ, %rax
    movq tty_fd(%rip), %rdi
    leaq keybuf(%rip), %rsi
    movq $16, %rdx
    syscall
    testq %rax, %rax
    jle exit_clean
    leaq keybuf(%rip), %rsi
    movq %rax, %rcx
key_loop:
    movzbq (%rsi), %rax
    cmpb $0, search_active(%rip)
    je key_dispatch
    movzbq search_escape_state(%rip), %rdx
    testb %dl, %dl
    jnz key_search_escape_continue
    cmpb $0x09, %al
    je key_search_next_result
    cmpb $0x1B, %al
    je key_search_escape_start
    cmpb $0x0D, %al
    je key_search_close
    cmpb $0x0A, %al
    je key_search_close
    cmpb $0x08, %al
    je key_search_backspace
    cmpb $0x7F, %al
    je key_search_backspace
    cmpb $0x20, %al
    jb key_next
    cmpb $0x7E, %al
    ja key_next
    movq search_len(%rip), %rdx
    cmpq $SEARCH_CAP, %rdx
    jae key_next
    cmpb $'a', %al
    jb L1_key_search_append
    cmpb $'z', %al
    ja L1_key_search_append
    subb $32, %al
L1_key_search_append:
    leaq search_query(%rip), %rdi
    movb %al, (%rdi,%rdx)
    incq %rdx
    movq %rdx, search_len(%rip)
    movb $0, (%rdi,%rdx)
    movq $0, search_selected(%rip)
    movb $0, search_escape_state(%rip)
    jmp key_next
key_search_next_result:
    call select_next_search_result
    jmp key_next
key_search_escape_start:
    movb $1, search_escape_state(%rip)
    jmp key_next
key_search_escape_continue:
    cmpb $1, %dl
    jne L2_key_search_escape_continue
    cmpb $'[', %al
    jne key_search_cancel
    movb $2, search_escape_state(%rip)
    jmp key_next
L2_key_search_escape_continue:
    cmpb $2, %dl
    jne key_search_cancel
    cmpb $'Z', %al
    jne key_search_cancel
    movb $0, search_escape_state(%rip)
    call select_previous_search_result
    jmp key_next
key_dispatch:
    cmpb $'/', %al
    je key_search_open
    cmpb $'+', %al
    je key_zoom_in
    cmpb $'-', %al
    je key_zoom_out
    cmpb $'h', %al
    je key_h
    cmpb $'H', %al
    je key_h
    cmpb $'l', %al
    je key_l
    cmpb $'L', %al
    je key_l
    cmpb $'j', %al
    je key_j
    cmpb $'J', %al
    je key_j
    cmpb $'k', %al
    je key_k
    cmpb $'K', %al
    je key_k
    cmpb $'q', %al
    je exit_clean
    cmpb $'Q', %al
    je exit_clean
key_next:
    incq %rsi
    decq %rcx
    jnz key_loop
    jmp main_loop
key_search_open:
    movb $1, search_active(%rip)
    movq $0, search_len(%rip)
    movb $0, search_query(%rip)
    movq $0, search_selected(%rip)
    movb $0, search_escape_state(%rip)
    jmp key_next
key_search_cancel:
    movb $0, search_active(%rip)
    movq $0, search_len(%rip)
    movb $0, search_query(%rip)
    movb $0, search_escape_state(%rip)
    jmp key_next
key_search_close:
    movb $0, search_escape_state(%rip)
    call navigate_selected_search_result
    movb $0, search_active(%rip)
    jmp key_next
key_search_backspace:
    movq search_len(%rip), %rdx
    testq %rdx, %rdx
    jz key_next
    decq %rdx
    movq %rdx, search_len(%rip)
    leaq search_query(%rip), %rdi
    movb $0, (%rdi,%rdx)
    movq $0, search_selected(%rip)
    movb $0, search_escape_state(%rip)
    jmp key_next
key_zoom_in:
    movq zoom_index(%rip), %rdi
    incq %rdi
    call set_zoom
    jmp key_next
key_zoom_out:
    movq zoom_index(%rip), %rdi
    decq %rdi
    call set_zoom
    jmp key_next
