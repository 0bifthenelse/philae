.section .rodata
esc_alt_enter: .asciz "\033[?1049h"
esc_alt_leave: .asciz "\033[?1049l"
esc_hide:      .asciz "\033[?25l"
esc_show:      .asciz "\033[?25h"
esc_home:      .asciz "\033[H"
esc_clear:     .asciz "\033[2J"
msg_err:       .asciz "[philae] "
msg_tty:       .asciz "terminal setup failed"
msg_ttyget:    .asciz "tcget failed"
msg_ttyset:    .asciz "tcset failed"
msg_data:      .asciz "cannot open map data"
msg_big:       .asciz "map data too large"
msg_poll:      .asciz "input poll failed"
data_path:     .asciz "auch-map/france/auch/derived/streets.geojsonl"
dev_tty:       .asciz "/dev/tty"
k_linestring:  .ascii "\"LineString\""
k_props:       .ascii "\"properties\":"
k_highway:     .ascii "\"highway\":\""
k_speed:       .ascii "\"maxspeed\":\""
k_name:        .ascii "\"name\":\""
k_coords:      .ascii "\"coordinates\":"
pow10:         .quad 1, 10, 100, 1000, 10000, 100000
kx:            .quad 12175
ky:            .quad 8388
glyphs:        .byte 46, 58, 58, 46, 61, 43, 35, 35
class_tab:
    .asciz "trunk";         .byte 7
    .asciz "primary";       .byte 6
    .asciz "secondary";     .byte 5
    .asciz "tertiary";      .byte 4
    .asciz "residential";   .byte 3
    .asciz "unclassified";  .byte 3
    .asciz "living_street"; .byte 3
    .asciz "service";       .byte 2
    .asciz "pedestrian";    .byte 2
    .asciz "track";         .byte 2
    .asciz "path";          .byte 2
    .asciz "footway";       .byte 2
    .asciz "cycleway";      .byte 2
    .asciz "steps";         .byte 2
    .asciz "construction";  .byte 1
    .asciz "raceway";       .byte 1
    .asciz "";              .byte 0
cn0: .asciz "-"
cn1: .asciz "OTHER"
cn2: .asciz "MINOR"
cn3: .asciz "RESIDENTIAL"
cn4: .asciz "TERTIARY"
cn5: .asciz "SECONDARY"
cn6: .asciz "PRIMARY"
cn7: .asciz "TRUNK"
cls_ptrs: .quad cn0, cn1, cn2, cn3, cn4, cn5, cn6, cn7
s_auch: .asciz "AUCH LON "
s_lat:  .asciz " LAT "
s_zoom: .asciz " Z8000"
s_brk:  .asciz " ["
s_cls:  .asciz "] "
s_unn:  .asciz "UNNAMED"
s_sp:   .asciz " "
s_kmh:  .asciz " KM/H"
s_unk:  .asciz "-- KM/H"
s_keys: .asciz " | H J K L PAN Q QUIT"
msg_nl: .asciz "\n"
