raw_mode:
    movq $SYS_IOCTL, %rax
    movq tty_fd(%rip), %rdi
    movq $TCGETS, %rsi
    leaq term_orig(%rip), %rdx
    syscall
    testq %rax, %rax
    js die_ttyget
    movq term_orig+0(%rip), %rax
    movq %rax, term_raw+0(%rip)
    movq term_orig+8(%rip), %rax
    movq %rax, term_raw+8(%rip)
    movq term_orig+16(%rip), %rax
    movq %rax, term_raw+16(%rip)
    movq term_orig+24(%rip), %rax
    movq %rax, term_raw+24(%rip)
    movq term_orig+32(%rip), %rax
    movq %rax, term_raw+32(%rip)
    movq term_raw+12(%rip), %rax
    andq $~((1<<1)|(1<<3)|(1<<0)|(1<<5)), %rax
    movq %rax, term_raw+12(%rip)
    movq term_raw(%rip), %rax
    andq $~(1<<4), %rax
    movq %rax, term_raw(%rip)
    movb $1, term_raw+23(%rip)
    movb $0, term_raw+22(%rip)
    movq $SYS_IOCTL, %rax
    movq tty_fd(%rip), %rdi
    movq $TCSETS, %rsi
    leaq term_raw(%rip), %rdx
    syscall
    testq %rax, %rax
    js die_ttyset
    movb $1, term_active(%rip)
    ret
die_ttyget:
    leaq msg_ttyget(%rip), %rdi
    call die
die_ttyset:
    leaq msg_ttyset(%rip), %rdi
    call die

