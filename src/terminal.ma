restore_term:
    cmpb $0, term_active(%rip)
    je L1_restore_term
    leaq esc_show(%rip), %rsi
    call out_str
    leaq esc_alt_leave(%rip), %rsi
    call out_str
    movq $SYS_IOCTL, %rax
    movq tty_fd(%rip), %rdi
    movq $TCSETS, %rsi
    leaq term_orig(%rip), %rdx
