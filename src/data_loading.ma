load_data:
    pushq %rbx
    pushq %r12
    pushq %r13
    pushq %r14
    pushq %r15
    movq $SYS_OPEN, %rax
    leaq data_path(%rip), %rdi
    xorq %rsi, %rsi
    syscall
    testq %rax, %rax
    js die_data
    movq %rax, %r14
    movq $SYS_FSTAT, %rax
    movq %r14, %rdi
    leaq statbuf(%rip), %rsi
    syscall
    testq %rax, %rax
    js die_data
    movq statbuf+48(%rip), %r13
    cmpq $0x4000000, %r13
    jbe L1_load_data
    movq $SYS_CLOSE, %rax
    movq %r14, %rdi
    syscall
    leaq msg_big(%rip), %rdi
    call die
L1_load_data:  movq $SYS_MMAP, %rax
    xorq %rdi, %rdi
    movq %r13, %rsi
    movq $PROT_READ, %rdx
    movq $MAP_PRIVATE, %r10
    movq %r14, %r8
    xorq %r9, %r9
    syscall
    testq %rax, %rax
    js die_data
    movq %rax, %r12
    leaq (%r12,%r13), %r15
    movq %r12, %rbx
    jmp parse_outer
die_data:
    leaq msg_data(%rip), %rdi
    call die
parse_outer:
    cmpq %r15, %rbx
    jae parse_done
    movq %rbx, %rdi
    movq %r15, %rsi
    subq %rbx, %rsi
    call find_nl
    testq %rax, %rax
    js parse_done
    movq %rax, %r13
    movq %rbx, %rdi
    movq %r13, %rsi
    call parse_geojson_line
    addq %r13, %rbx
    incq %rbx
    jmp parse_outer
parse_done:
    movq $SYS_CLOSE, %rax
    movq %r14, %rdi
    syscall
    popq %r15
    popq %r14
    popq %r13
    popq %r12
    popq %rbx
    ret

