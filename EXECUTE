#!/bin/sh
# EXECUTE - build and run the philae master assembly (master.ma).
#
# This is the runnable realization of the @build/@run contract documented in
# master.ma's file header:
#   as -o /tmp/master.o master.ma && ld -e _start -o /tmp/master /tmp/master.o
#   /tmp/master  ->  stdout: "Hello World", exit 0
#
# Build artifacts live in /tmp (never the repo). The master binary's exit
# status is propagated so callers can chain on it.
# Em dashes (U+2014) are strictly forbidden in comments and code: ASCII
# hyphens only.

set -u

# Resolve this script's directory so EXECUTE works from any cwd.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
cd "$SCRIPT_DIR" || exit 1

MASTER_ASM=master.ma
OBJECT=/tmp/master.o
BINARY=/tmp/master

echo "[EXECUTE] assembling $MASTER_ASM"
as -o "$OBJECT" "$MASTER_ASM" || { echo "[EXECUTE] assemble failed" >&2; exit 1; }

echo "[EXECUTE] linking $BINARY"
ld -e _start -o "$BINARY" "$OBJECT" || { echo "[EXECUTE] link failed" >&2; exit 1; }

echo "[EXECUTE] running $BINARY"
"$BINARY"
status=$?
echo "[EXECUTE] master exited with status $status"
exit "$status"
